{
  "manifest_version": 3,
  "name": "提词器：编程页面",
  "version": "0.2",
  "description": "把在线编辑器里的代码、题面和运行输出推给本地提词器（ws://localhost:8766/page）。",
  "permissions": [
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "reader.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "relay.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}